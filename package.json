{
	"name": "coco-ecommerce",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --experimental-sqlite node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --experimental-sqlite node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.31.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/kit": "^2.25.1",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^26.2.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.3.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.36.12",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.37.0",
		"vite": "^7.0.5",
		"vite-plugin-devtools-json": "^0.2.1"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.2.8",
		"@fontsource-variable/jost": "^5.2.8",
		"@fontsource/jost": "^5.2.8",
		"@fontsource/poppins": "^5.2.7",
		"@fontsource/volkhov": "^5.2.8",
		"@midudev/tailwind-animations": "^0.2.0",
		"drizzle-orm": "^0.45.2",
		"svelte-5-french-toast": "^2.0.5"
	}
}
